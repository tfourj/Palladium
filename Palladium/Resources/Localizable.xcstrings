    "packages.restore_pip.confirm.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes imported payload packages and user-added managed packages, then reinstalls the remaining packages from the configured source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、インポートされたペイロードパッケージとユーザーが追加した管理パッケージが削除され、構成されたソースから残りのパッケージが再インストールされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 페이로드 패키지 및 사용자가 추가한 관리 패키지를 제거한 후, 설정된 소스에서 나머지 패키지를 다시 설치합니다."
          }
        },
