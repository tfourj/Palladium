    "settings.download_modes.customize_options.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to reorder. Turn an option off to hide it from the download pickers. At least one option must stay visible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして並べ替えます。ダウンロードピッカーから非表示にするにはオプションをオフにしてください。少なくとも1つのオプションが表示されたままにする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 순서를 변경하세요. 다운로드 선택기에서 옵션을 숨기려면 끄세요. 하나 이상의 옵션은 켜져 있어야 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
