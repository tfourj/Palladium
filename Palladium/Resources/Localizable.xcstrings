    "settings.ui.modes.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal download mode matches the main picker on the Download tab. If memory is off, it resets to Video when the app launches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常のダウンロードモードは、ダウンロードタブのメインピッカーと一致します。メモリがオフの場合、アプリが起動するとビデオにリセットされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 다운로드 모드는 다운로드 탭의 기본 선택기와 일치합니다. 기억 옵션이 꺼져 있으면 앱 실행 시 '비디오'로 재설정됩니다."
          }
        },
        "lt" : {
