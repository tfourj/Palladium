    "shortcuts.error.busy" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another download or package task is already running. Palladium filled in the shortcut URL, but you need to start it again after the current task finishes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のダウンロードまたはパッケージタスクが既に実行されています。 ショートカットURLに記入されたPalladium ですが、現在のタスクが完了した後に再度起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 다운로드 또는 패키지 작업이 이미 실행 중입니다. Palladium에 단축어 URL이 입력되었지만, 현재 작업이 완료된 후 다시 시작해야 합니다."
          }
        },
