    "settings.download_behavior.incomplete_history.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a link to history when a download starts, so failed, cancelled, or interrupted downloads remain available. Link history must be enabled."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードの開始時に履歴へのリンクを追加します。そのため、失敗、キャンセル、または中断されたダウンロードは引き続き利用可能です。リンク履歴を有効にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드가 시작될 때 링크를 기록에 추가하여 실패, 취소 또는 중단된 다운로드도 계속 확인할 수 있도록 합니다. 링크 기록이 활성화되어 있어야 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adds a link to history when a download starts, so failed, cancelled, or interrupted downloads remain available. Link history must be enabled."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在下载开始时向历史记录添加链接，从而确保失败、取消或中断的下载任务仍可访问。必须启用链接历史记录功能。"
          }
        }
      }
    },
