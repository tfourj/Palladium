    "download.quality.queued.help" : {
      "comment" : "Explains how quality selection behaves for queued downloads.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick max quality applies one choice to every pending download and asks again if a link lacks it. Choose for every link asks for each link before it downloads."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最高画質を選択」を適用：保留中のすべてのダウンロードに同じ設定を一括適用し、最高画質が存在しないリンクについては改めて確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'최고 품질 선택'은 대기 중인 모든 다운로드에 하나의 설정을 적용하며, 링크에 해당 품질이 없으면 다시 묻습니다. '모든 링크마다 선택'은 다운로드하기 전에 각 링크마다 묻습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pick max quality applies one choice to every pending download and asks again if a link lacks it. Choose for every link asks for each link before it downloads."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“选择最高画质”会将同一选项应用于所有待下载任务，若某链接不提供该画质，则会再次询问。\n“为每个链接单独选择”则会在下载前针对每个链接进行询问。"
          }
        }
      }
    },
