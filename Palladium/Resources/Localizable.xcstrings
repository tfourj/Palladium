    "download.filename.help" : {
      "comment" : "Help text explaining filename preset behavior and existing output argument priority.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default shortens long titles to 200 bytes. Video ID uses the media site's stable ID. Existing -o or --output arguments take priority."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは、長いタイトルを 200 バイトに短縮します。ビデオ ID ではメディアサイトの安定した ID を使用します。既存の -o または --output 引数は優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값은 긴 제목을 200바이트로 줄입니다. 비디오 ID는 미디어 사이트의 고유 ID를 사용합니다. 기존 -o 또는 --output 인수가 우선 적용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Default shortens long titles to 200 bytes. Video ID uses the media site's stable ID. Existing -o or --output arguments take priority."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认情况下，长标题会被截断至 200 字节。视频 ID 采用媒体网站的固定 ID。现有的 `-o` 或 `--output` 参数具有优先权。"
          }
        }
      }
    },
