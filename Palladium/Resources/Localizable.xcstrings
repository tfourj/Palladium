    "settings.storage.cache.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cache stores yt-dlp metadata and web assets. Clearing it may make the next run a little slower."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャッシュには、yt-dlpメタデータとWebアセットが保存されます。クリアすると、次の実行が少し遅くなる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐시에는 yt-dlp 메타데이터와 웹 에셋이 저장됩니다. 캐시를 지우면 다음 실행 시 속도가 다소 느려질 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The cache stores yt-dlp metadata and web assets. Clearing it may make the next run a little slower."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该缓存存储了 yt-dlp 的元数据和网页资源。清除缓存可能会导致下次运行时速度稍慢。"
          }
        }
      }
    },
