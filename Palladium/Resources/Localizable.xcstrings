    "settings.ui.retry_failed.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically retries playlist items that fail because of thumbnail download or thumbnail embedding by rerunning them once without thumbnail options."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サムネイルのダウンロードやサムネイル埋め込みで失敗したプレイリストの項目を、サムネイルオプションなしで一度再起動すると自動的に再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "썸네일 다운로드 또는 썸네일 포함 작업 실패로 오류가 발생한 재생목록 항목을 썸네일 옵션 없이 한 번 다시 실행하여 자동으로 재시도합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatically retries playlist items that fail because of thumbnail download or thumbnail embedding by rerunning them once without thumbnail options."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于因缩略图下载或嵌入失败而无法处理的播放列表项，系统会自动重试一次，即在不启用缩略图选项的情况下再次尝试处理。"
          }
        }
      }
    },
