    "settings.ui.after_download.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask shows the same action picker after each successful download. Other options run automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Ask」は、ダウンロードが成功するたびに同じアクションピッカーを表示します。その他のオプションは自動的に実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'묻기'는 다운로드가 성공할 때마다 동일한 동작 선택기를 표시합니다. 다른 옵션은 자동으로 실행됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ask shows the same action picker after each successful download. Other options run automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“询问”选项会在每次成功下载后显示相同的操作选择器。其他选项则会自动执行。"
          }
        }
      }
    },
