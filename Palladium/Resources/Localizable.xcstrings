    "download.quality.video.codec_help" : {
      "comment" : "A description of the video codec compatibility options.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 and H.265/HEVC in MP4 are compatible with the Photos app. H.264 is preferred when both are available."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MP4形式のH.264およびH.265/HEVCは、「写真」アプリに対応しています。両方を利用可能な場合は、H.264が優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MP4 컨테이너의 H.264 및 H.265/HEVC는 사진 앱과 호환됩니다. 둘 다 사용 가능한 경우 H.264가 우선 적용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "H.264 and H.265/HEVC in MP4 are compatible with the Photos app. H.264 is preferred when both are available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MP4 格式中的 H.264 和 H.265/HEVC 均与“照片”应用兼容。若两者均可用，建议优先使用 H.264。"
          }
        }
      }
    },
