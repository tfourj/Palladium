    "settings.storage.saved.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved Files contains downloads you explicitly kept. Clearing this section removes those copies from Palladium storage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたファイルには、明示的に保存したダウンロードが含まれています。このセクションをクリアすると、Palladiumストレージからそれらのコピーが削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'저장된 파일'에는 사용자가 명시적으로 보관한 다운로드 파일이 포함되어 있습니다. 이 섹션을 지우면 Palladium 저장 공간에서 해당 복사본이 제거됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saved Files contains downloads you explicitly kept. Clearing this section removes those copies from Palladium storage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“已保存文件”包含您明确保留的下载内容。清除此部分将从 Palladium 存储空间中移除这些副本。"
          }
        }
      }
    },
