    "download.formats.source_help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video and audio show the source streams and their sizes. Final shows the merged container, including thumbnail handling."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画と音質には、ソースストリームとそのサイズが表示されます。最後に、サムネイルの処理を含むマージされたコンテナが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'비디오'와 '오디오'는 원본 스트림 및 크기를 나타냅니다. '최종'은 썸네일 처리가 포함된 병합 컨테이너를 나타냅니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Video and audio show the source streams and their sizes. Final shows the merged container, including thumbnail handling."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频和音频部分展示了源流及其大小。最终部分展示了合并后的容器，其中包括缩略图的处理。"
          }
        }
      }
    },
