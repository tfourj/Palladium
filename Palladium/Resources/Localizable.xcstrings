      "comment" : "Help text explaining the audio preset used for video downloads.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Best Compatible prefers AAC audio for broader playback support. Best Quality keeps the best available source audio without preferring a codec."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換性重視：再生互換性を高めるため、AAC音声を優先します。\n高音質重視：特定のコーデックを優先せず、利用可能な最高のソース音質をそのまま維持します。"
          }
