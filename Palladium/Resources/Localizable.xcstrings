    "settings.post_processing.remux" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remux"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマックス（再多重化）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리먹스"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remux"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重封装"
          }
        }
      }
    },
    "settings.post_processing.remux_help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remuxing changes the container without re-encoding, so it is faster and preserves quality. It can fail if the selected container does not support the original codecs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再多重化は、再エンコードせずに容器を変更するので、より速く、品質を維持します。 選択したコンテナが元のコーデックをサポートしていない場合、失敗する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리먹싱은 재인코딩 없이 컨테이너만 변경하므로 속도가 더 빠르고 원본 품질을 유지합니다. 선택한 컨테이너가 원본 코덱을 지원하지 않는 경우 실패할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remuxing changes the container without re-encoding, so it is faster and preserves quality. It can fail if the selected container does not support the original codecs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“重封装”是在不重新编码的情况下更改容器格式，因此速度更快且能保持画质。如果所选容器不支持原始编码格式，该操作可能会失败。"
          }
        }
      }
    },
    "settings.post_processing.scope" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to video downloads, including format selections. Audio-only and image downloads are unchanged. Enabled conversion overrides video container and conversion arguments. Queued downloads keep the settings chosen when added."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーマット選択を含む動画ダウンロードに適用されます。音声のみと画像のダウンロードは変更されません。 変換を有効にすると、動画コンテナと変換引数が上書きされます。キューに追加されたダウンロードは、追加時に選択された設定を維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "형식 선택을 포함한 비디오 다운로드에 적용됩니다. 오디오 전용 및 이미지 다운로드에는 영향을 주지 않습니다. 변환을 활성화하면 비디오 컨테이너 및 변환 인수가 덮어써집니다. 대기열에 있는 다운로드는 추가할 때 선택한 설정을 유지합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Applies to video downloads, including format selections. Audio-only and image downloads are unchanged. Enabled conversion overrides video container and conversion arguments. Queued downloads keep the settings chosen when added."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于视频下载，包括格式选择。纯音频和图片下载不受影响。启用转换功能将覆盖视频容器及转换参数。已加入队列的下载任务将保留添加时所选的设置。"
          }
        }
      }
    },
