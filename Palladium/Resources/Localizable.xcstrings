    "settings.storage.downloads.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only affects Palladium's temporary download folder. Use it to remove stale run folders without touching Saved Files."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはPalladiumの一時的なダウンロードフォルダにのみ影響します。保存されたファイルに触れずに古い実行フォルダを削除するために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이는 Palladium의 임시 다운로드 폴더에만 영향을 줍니다. '저장된 파일'을 건드리지 않고 오래된 실행 폴더를 삭제하려면 이 기능을 사용하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This only affects Palladium's temporary download folder. Use it to remove stale run folders without touching Saved Files."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这仅影响 Palladium 的临时下载文件夹。可利用此功能清理过期的运行文件夹，而不会触动已保存的文件。"
          }
        }
      }
    },
