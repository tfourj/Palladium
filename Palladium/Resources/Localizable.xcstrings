    "settings.ui.downloads.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, Palladium keeps completed downloads in Palladium/Temp and shows them in the Downloads tab. Saving to Saved Files copies them without removing the temporary originals."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、Palladiumは完了したダウンロードをPalladium/Tempフォルダに保持し、ダウンロードタブに表示します。Saved Filesへの保存は、一時保存されたオリジナルファイルを削除せずにコピーします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 완료된 다운로드를 Palladium/Temp에 보관하고 '다운로드' 탭에 표시합니다. '저장된 파일'로 저장하면 임시 원본을 삭제하지 않고 복사합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, Palladium keeps completed downloads in Palladium/Temp and shows them in the Downloads tab. Saving to Saved Files copies them without removing the temporary originals."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用该功能后，Palladium 会将已完成的下载内容保留在 Palladium/Temp 文件夹中，并将其显示在“下载”选项卡内。将其保存到“已保存文件”时，系统会进行复制，而不会删除临时的原始文件。"
          }
        }
      }
    },
