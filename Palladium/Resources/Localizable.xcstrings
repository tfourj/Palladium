    "download.filename.custom.help" : {
      "comment" : "Help text for a user-supplied yt-dlp output filename template.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a yt-dlp output template. Include %(ext)s for the file extension. Leave blank to use Default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "yt-dlp出力テンプレートを入力します。ファイル拡張子には %(ext)s を含めます。デフォルトを使用するには空白のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "yt-dlp 출력 템플릿을 입력하세요. 파일 확장자에는 %(ext)s를 포함해야 합니다. 비워 두면 기본값이 사용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enter a yt-dlp output template. Include %(ext)s for the file extension. Leave blank to use Default."
          }
