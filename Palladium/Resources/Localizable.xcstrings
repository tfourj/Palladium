    "settings.storage.overview.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporary Downloads stores active and recent run folders. Saved Files keeps copies made with Save to App Folder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「一時ダウンロード」には、実行中および最近完了したダウンロードのフォルダが保存されます。「保存されたファイル」には、「アプリフォルダへ保存」機能で保存したファイルのコピーが保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'임시 다운로드'에는 활성 및 최근 실행 폴더가 저장됩니다. '저장된 파일'에는 '앱 폴더에 저장'으로 생성된 복사본이 보관됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Temporary Downloads stores active and recent run folders. Saved Files keeps copies made with Save to App Folder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“临时下载”存储处于活动状态及最近运行的文件夹；“已保存文件”则存放通过“保存到应用文件夹”功能生成的副本。"
          }
        }
      }
    },
